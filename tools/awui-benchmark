#!/usr/bin/env python3
"""Run the deterministic AR-0104 release-scale qualification."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from awtui.performance import run_benchmark, write_report


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", help="write the public JSON report to this path")
    args = parser.parse_args()
    report = write_report(args.output) if args.output else run_benchmark()
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["passed"] and all(report["gates"].values()) else 1


if __name__ == "__main__":
    sys.exit(main())
