{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/coordinator-board-request-1.0.json",
  "title": "Coordinator company dashboard rollup request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "ar_id", "task_revision", "packet_digest", "rollup_revision", "pages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "coordinator-board-request"},
    "project_id": {"type": "string", "minLength": 1},
    "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "packet_digest": {"type": "string", "minLength": 1},
    "rollup_revision": {"type": "integer", "minimum": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["page_id", "title", "status"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "completed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "bottlenecks": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
