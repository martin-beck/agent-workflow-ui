{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/coordinator-board-response-1.0.json",
  "title": "Coordinator company dashboard response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "ar_id", "task_revision", "packet_digest", "rollup_revision", "page_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "coordinator-board-response"},
    "project_id": {"type": "string", "minLength": 1},
    "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "packet_digest": {"type": "string", "minLength": 1},
    "rollup_revision": {"type": "integer", "minimum": 1},
    "page_id": {"type": "string", "minLength": 1}
  }
}
