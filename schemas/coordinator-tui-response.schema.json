{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/coordinator-tui-response-1.0.json",
  "title": "Agent Workflow TUI to Coordinator response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "ar_id", "task_revision", "decision_request_ref", "event", "ar_update"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "coordinator-tui-response"},
    "project_id": {"type": "string", "minLength": 1}, "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "task_revision": {"type": "integer", "minimum": 1}, "decision_request_ref": {"type": "string", "pattern": "^AWG-"},
    "event": {"type": "object", "required": ["session_id", "sequence", "event_type", "payload"], "properties": {
      "session_id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1},
      "event_type": {"enum": ["clarify", "select", "reject", "request-more-evidence", "add-proposal", "reconciled"]}, "payload": {"type": "object"}
    }},
    "ar_update": {"type": "object", "additionalProperties": false, "required": ["decision_status", "ar_status", "description_append", "specification_update"], "properties": {
      "decision_status": {"enum": ["pending", "in_progress", "resolved", "superseded"]},
      "ar_status": {"type": "string", "minLength": 1}, "description_append": {"type": "string"},
      "specification_update": {"type": "object", "required": ["request_id", "point_id", "disposition"], "properties": {
        "request_id": {"type": "string", "pattern": "^AWG-"}, "point_id": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1}, "selected_candidate": {"type": ["string", "null"]},
        "selected": {"type": ["string", "null"]}, "user_proposal": {"type": ["object", "null"]}
      }}
    }}
  }
}
