{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "ar_id", "task_revision", "packet_digest", "session_id", "sequence", "event_type", "payload"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "session_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["acknowledge", "clarify", "select", "reject", "request-more-evidence", "add-proposal", "safe-exit", "reopen", "reconciled"]},
    "payload": {"type": "object"}
  }
}
