{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-ui.org/schemas/android-endpoint-candidates.schema.json",
  "title": "Android endpoint candidates",
  "type": "object",
  "required": ["schema_version", "candidates", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "diagnostics": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "candidates": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "source_alias", "host", "port", "address_family", "provenance", "priority", "host_key_fingerprints", "expires_at"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^ssh-[a-f0-9]{16}$"},
        "source_alias": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "address_family": {"enum": ["name", "ipv4", "ipv6"]},
        "provenance": {"enum": ["ssh_config", "vpn", "dns_address", "dns", "relay", "public_ip"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "host_key_fingerprints": {"type": "array", "items": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]+$"}},
        "expires_at": {"type": ["integer", "null"]}
      }
    }}
  }
}
