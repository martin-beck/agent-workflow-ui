{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/coordinator-tui-request-1.0.json",
  "title": "Coordinator to Agent Workflow TUI interaction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "ar", "interaction", "guidance_request", "session_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "coordinator-tui-request"},
    "project_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "host_handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["ssh_host", "remote_session_file", "remote_event_file", "client_capabilities"],
      "properties": {
        "ssh_host": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "remote_session_file": {"type": "string", "minLength": 1},
        "remote_event_file": {"type": "string", "minLength": 1},
        "bootstrap_script": {"type": "string", "pattern": "^/[^\\r\\n]*$"},
        "runtime_release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "client_capabilities": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "shell"],
          "properties": {
            "platform": {"enum": ["windows", "linux", "macos", "freebsd"]},
            "shell": {"enum": ["powershell", "cmd", "bash", "zsh", "sh"]},
            "ssh_config": {"type": "string", "minLength": 1},
            "gui_available": {"type": "boolean"},
            "architecture": {"type": "string", "minLength": 1},
            "distribution": {"type": "string", "minLength": 1},
            "runtime": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "documents": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "design": {"type": "string"},
        "workplan": {"type": "string"}
      }
    },
    "paused_sessions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "project_id", "ar_id", "task_revision", "packet_digest", "session_file", "unresolved"],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "project_id": {"type": "string", "minLength": 1},
          "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
          "task_revision": {"type": "integer", "minimum": 1},
          "packet_digest": {"type": "string", "minLength": 1},
          "session_file": {"type": "string", "pattern": "^/[^\\r\\n]*$"},
          "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "batch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "kind", "project_id", "ar", "interaction", "guidance_request", "session_id"],
        "properties": {
          "schema_version": {"const": "1.0"},
          "kind": {"const": "coordinator-tui-request"},
          "project_id": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "host_handoff": {"$ref": "#/properties/host_handoff"},
          "documents": {"$ref": "#/properties/documents"},
          "ar": {"$ref": "#/properties/ar"},
          "interaction": {"$ref": "#/properties/interaction"},
          "guidance_request": {"type": "object", "required": ["schema_version", "request_id", "context", "formal_check", "candidates"]}
        }
      }
    },
    "ar": {
      "type": "object", "additionalProperties": false,
      "required": ["ar_id", "task_revision", "status", "description", "specification"],
      "properties": {
        "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
        "task_revision": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "specification": {"type": "object"}
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["interaction_required", "decision_request_ref", "decision_status", "trigger"],
      "properties": {
        "interaction_required": {"const": true},
        "decision_request_ref": {"type": "string", "pattern": "^AWG-"},
        "decision_status": {"enum": ["pending", "in_progress", "resolved", "superseded"]},
        "trigger": {"enum": ["clarification", "decision", "guidance", "mandatory-approval", "recovery"]},
        "decision_class": {"type": "string", "minLength": 1},
        "oracle_deadline": {"type": "string", "minLength": 1}
      }
    },
    "guidance_request": {"type": "object", "required": ["schema_version", "request_id", "context", "formal_check", "candidates"]}
  }
}
