{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/android-bridge.schema.json",
  "title": "Agent Workflow Android decision bridge",
  "type": "object",
  "required": ["schema_version", "kind", "project_id", "session_id", "task_revision", "packet_digest", "sequence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["android-decision-request", "android-decision-event", "android-ack"]},
    "project_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 8},
    "session_id": {"type": "string", "minLength": 8},
    "task_revision": {"type": "integer", "minimum": 1},
    "packet_digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["acknowledge", "select", "reject", "clarify", "add-proposal", "save", "reopen", "safe-exit", "reconciled"]},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
